# Server-side NASA FIRMS Area API key.
# Never prefix this with NEXT_PUBLIC_ or commit a real value.
FIRMS_MAP_KEY=

# Optional server-side Postgres connection string (Supabase transaction-mode
# pooler URI, port 6543). Enables the shared read-through cache and the
# historical record served by /api/history. Without it the app behaves
# exactly as before.
# Deliberately app-scoped: generic DATABASE_URL/POSTGRES_URL values are
# IGNORED so a variable inherited from a shared environment or integration
# can never point this app at the wrong database.
# See docs/db/README.md. Never prefix with NEXT_PUBLIC_ or commit a real value.
FIREWATCH_DATABASE_URL=

# Optional server-side X API bearer token for automatic posts from
# @112Greece and @pyrosvestiki. X API access may incur usage charges.
# The tracker works without this token, keeps its other sources active, and
# labels these optional official social feeds as unconfigured.
# Never prefix this with NEXT_PUBLIC_ or commit a real value.
X_BEARER_TOKEN=
