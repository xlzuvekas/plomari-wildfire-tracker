# Server-side NASA FIRMS Area API key.
# Never prefix this with NEXT_PUBLIC_ or commit a real value.
FIRMS_MAP_KEY=

# Optional server-side X API bearer token for automatic posts from
# @112Greece, @pyrosvestiki, and @CivPro_GR. X API access may incur usage
# charges.
# The tracker works without this token, keeps its other sources active, and
# labels these optional official social feeds as unconfigured.
# Never prefix this with NEXT_PUBLIC_ or commit a real value.
X_BEARER_TOKEN=

# Server-only Supabase Data API configuration for the shadow v3 read model.
# Never prefix either name with NEXT_PUBLIC_ and never substitute service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only, disabled-by-default OpenRouter configuration for an internal,
# evidence-cited AI orientation draft. Never prefix any of these with
# NEXT_PUBLIC_. Use a dedicated OpenRouter key with its own hard spending cap.
# The adapter is compiled to request only the openrouter/free router.
OPENROUTER_API_KEY=
OPENROUTER_OODA_ENABLED=false
# Comma-separated OpenRouter provider slugs approved for this workload.
OPENROUTER_OODA_PROVIDER_ALLOWLIST=
OPENROUTER_OODA_TIMEOUT_MS=15000
OPENROUTER_OODA_MAX_INPUT_BYTES=65536
OPENROUTER_OODA_MAX_RESPONSE_BYTES=131072
OPENROUTER_OODA_MAX_COMPLETION_TOKENS=800
OPENROUTER_SITE_URL=
