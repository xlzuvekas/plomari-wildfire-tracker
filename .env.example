# Server-side NASA FIRMS Area API key.
# Never prefix this with NEXT_PUBLIC_ or commit a real value.
FIRMS_MAP_KEY=

# Optional server-side X API bearer token for automatic posts from
# @112Greece, @pyrosvestiki, and @CivPro_GR. X API access may incur usage
# charges.
# The tracker works without this token, keeps its other sources active, and
# labels these optional official social feeds as unconfigured.
# Never prefix this with NEXT_PUBLIC_ or commit a real value.
X_BEARER_TOKEN=

# Server-only Supabase Data API configuration for the shadow v3 read model.
# Never prefix either name with NEXT_PUBLIC_ and never substitute service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Named, individually revocable Supabase secret API key whose fixed JWT
# template is exactly {"role":"firewatch_discovery_reader"}. This is not the
# default service-role secret key and must never be prefixed NEXT_PUBLIC_.
SUPABASE_DISCOVERY_READER_KEY=

# Server-only distributed admission for thermal v3. Keep the explicit kill
# switch false until Preview load tests establish every numeric limit. The
# Redis database must be single-region and close to Vercel/Supabase; use its
# write-capable REST token because the atomic lease script mutates counters.
# Never prefix any of these names with NEXT_PUBLIC_. Missing, malformed, slow,
# or exhausted admission infrastructure makes the endpoint fail closed.
# Vercel's automatically exposed system variables must also supply VERCEL_URL
# and VERCEL_DEPLOYMENT_ID; do not define either one manually.
FIREWATCH_THERMAL_V3_ADMISSION_ENABLED=false
# Use canary with a SHA-256 digest of a 43+ character bearer token until the
# full production gate is complete. Public mode must omit the digest.
FIREWATCH_THERMAL_V3_ACCESS_MODE=canary
FIREWATCH_THERMAL_V3_CANARY_TOKEN_SHA256=
# Either set this canonical REST pair, or use Vercel's generated Upstash pair
# below. If both pairs are present they must identify the same endpoint and
# carry the same write token, otherwise admission fails closed.
FIREWATCH_THERMAL_ADMISSION_REDIS_URL=
FIREWATCH_THERMAL_ADMISSION_REDIS_TOKEN=
FIREWATCH_THERMAL_ADMISSION_REDIS_KV_REST_API_URL=
FIREWATCH_THERMAL_ADMISSION_REDIS_KV_REST_API_TOKEN=
# Vercel may also add READ_ONLY_TOKEN, KV_URL, and REDIS_URL variables with the
# same prefix. The admission adapter deliberately ignores all three: its Lua
# transaction requires writes and its serverless transport is HTTPS REST.
# Independent 32+ character secret used only to HMAC Vercel-derived client IPs.
FIREWATCH_THERMAL_ADMISSION_IDENTITY_SECRET=
FIREWATCH_THERMAL_ADMISSION_BURST_LIMIT=
FIREWATCH_THERMAL_ADMISSION_BURST_WINDOW_SECONDS=
FIREWATCH_THERMAL_ADMISSION_SUSTAINED_LIMIT=
FIREWATCH_THERMAL_ADMISSION_SUSTAINED_WINDOW_SECONDS=
FIREWATCH_THERMAL_ADMISSION_GLOBAL_CONCURRENCY=
# Must be 12-30s, above the 5s reader abort and normal cleanup budget.
FIREWATCH_THERMAL_ADMISSION_LEASE_SECONDS=
# Admission REST calls are bounded to 100-1000ms and never retried.
FIREWATCH_THERMAL_ADMISSION_TIMEOUT_MS=

# Server-rendered feature gate for the first-page-only Nearby thermal evidence
# panel. Keep false until the database timeout/admission controls and dedicated
# firewatch_discovery_reader workload key are deployed and verified.
FIREWATCH_THERMAL_V3_UI_ENABLED=false

# Server-only, disabled-by-default OpenRouter configuration for an internal,
# evidence-cited AI orientation draft. Never prefix any of these with
# NEXT_PUBLIC_. Use a dedicated OpenRouter key with its own hard spending cap.
# The adapter is compiled to request only the openrouter/free router.
OPENROUTER_API_KEY=
OPENROUTER_OODA_ENABLED=false
# Comma-separated OpenRouter provider slugs approved for this workload.
OPENROUTER_OODA_PROVIDER_ALLOWLIST=
OPENROUTER_OODA_TIMEOUT_MS=15000
OPENROUTER_OODA_MAX_INPUT_BYTES=65536
OPENROUTER_OODA_MAX_RESPONSE_BYTES=131072
OPENROUTER_OODA_MAX_COMPLETION_TOKENS=800
OPENROUTER_SITE_URL=
